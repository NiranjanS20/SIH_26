# Optional: required only for the Google Routes benchmark (currently a placeholder).
GOOGLE_MAPS_API_KEY=

# Optional: enables live road-segment traffic refreshes from TomTom.
TOMTOM_API_KEY=

# Optional: IBM Quantum API token to execute micro-QAOA circuits on real IBM Quantum open source hardware
# Get your free token at https://quantum.ibm.com/
# If left empty, circuits execute on your local PC via Qiskit Aer simulator (MPS / statevector).
IBM_QUANTUM_TOKEN=
